NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PASAR-KARAT-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Server-only: never prefix these with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Billplz sandbox defaults. Change BILLPLZ_BASE_URL to https://www.billplz.com for production.
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com
BILLPLZ_SECRET_KEY=YOUR_BILLPLZ_SECRET_KEY
BILLPLZ_X_SIGNATURE_KEY=YOUR_BILLPLZ_X_SIGNATURE_KEY
BILLPLZ_COLLECTION_ID=YOUR_BILLPLZ_COLLECTION_ID
# Must be public so Billplz servers can reach /api/billplz/callback (Netlify staging or an HTTPS tunnel).
BILLPLZ_CALLBACK_BASE_URL=https://YOUR-PUBLIC-SITE.example

